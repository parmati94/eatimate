 "corrections": {
  "charred-chicken": [
   {
    "field": "protein_g",
    "used": 40,
    "reason": "The Fall 2026 chart prints 4 g protein for 4.3 oz of charred chicken breast at 370 kcal, 19 g fat and 1 g carbohydrate; those macros account for about 190 kcal, so the row contradicts its own calorie figure, and a chicken breast portion cannot carry 4 g of protein. Hot Honey Chicken and Crispy Chicken — the same chicken with a sauce or a crust — each print 40 g, and 40 g brings this row's macros to within rounding of its 370 kcal, so that is the figure used."
   }
  ]
