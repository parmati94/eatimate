{
  "name": "Little Caesars",
  "slug": "littlecaesars",
  "source": {
    "pdf_url": "https://www.datocms-assets.com/95658/1779298904-cr0027232_lj_nutri-info-allergen-ingredient_flyer_mgjur_minew-page-001.jpg",
    "retrieved": "2026-09-01"
  },
  "disclaimer_extra": "Little Caesars publishes its nutrition as a seven-page scanned flyer, not a data file, so these figures were read off pages 1 to 3 by hand. Every pizza figure is for a WHOLE pizza -- unlike Domino's and Papa John's, who publish per slice -- so divide by eight for one slice of a large. Topping figures are the chain's own note: \"amounts shown are the highest count for each topping\".",
  "glyph": "pizza",
  "formats": [
    "Round",
    "Deep Dish",
    "Thin Crust"
  ],
  "blurb": "Little Caesars is the one big pizza chain that still publishes nutrition as a scanned flyer, which is why almost nobody has put its numbers in a calculator. Its per-topping table adds onto a cheese base, so a Detroit-Style deep dish can be built topping by topping and then cut into the slices you actually eat.",
  "size_modes": [
    {
      "id": "round",
      "name": "Round",
      "default": true,
      "multipliers": {
        "base": 1,
        "topping": 1
      }
    },
    {
      "id": "detroit",
      "name": "Detroit-Style Deep Dish",
      "multipliers": {
        "base": 1,
        "topping": 1
      }
    }
  ],
  "default_flow": "build",
  "categories": [
    {
      "id": "item",
      "name": "Menu Pizzas",
      "select": "single",
      "flow": "preset"
    },
    {
      "id": "base",
      "name": "Pizza Base",
      "select": "single",
      "flow": "build",
      "in_preset": true,
      "note": "Every figure here is for a WHOLE pizza -- Little Caesars publishes per pizza, not per slice. They sell six crusts but publish a per-topping table for two, so those are the two you can build on; stuffed crust is here because they publish what adding it costs. Thin crust appears only as finished pizzas under menu items -- its toppings are not the round ones (their thin pepperoni is 150 calories over a thin cheese, against 350 on a round) -- and Crazy Crust and Stuffed Crazy Crust are on their menu but in neither the nutrition nor the ingredient pages of their guide."
    },
    {
      "id": "topping",
      "name": "Toppings",
      "select": "multi",
      "flow": "both",
      "note": "Little Caesars publishes the highest count for each topping, so a topping here is the most they put on. Building a pizza this way can come out above the same pizza on the menu -- base plus pepperoni lands exactly on the Classic Pepperoni, but base plus Italian sausage runs about 110 calories over it. Both figures are theirs."
    },
    {
      "id": "sides",
      "name": "Sides & Breads",
      "select": "multi",
      "flow": "extras"
    },
    {
      "id": "wings",
      "name": "Caesar Wings",
      "select": "multi",
      "flow": "extras"
    },
    {
      "id": "dips",
      "name": "Caesar Dips",
      "select": "multi",
      "flow": "extras"
    }
  ],
